{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "aggregate1",
					"description": "DATA"
				},
				{
					"name": "MapDrifted1",
					"description": "Creates an explicit mapping for each drifted column"
				}
			],
			"scriptLines": [
				"source(output(",
				"          SRCE_PLMN_CODE as string,",
				"          DEST_PLMN_CODE as string,",
				"          FILE_SEQ_NO as integer,",
				"          REC_NO as integer,",
				"          RAP_FILE_SEQ_NO as boolean,",
				"          RECORD_TYPE as short,",
				"          IMSI as long,",
				"          IMEI as string,",
				"          MSISDN as long,",
				"          MI_NO as long,",
				"          MDN as string,",
				"          CALLEVENT_START_TIMESTAMP as date,",
				"          CALLEVENT_START_TIMEUTC as boolean,",
				"          PDP_CONTEXT_TIMESTAMP as string,",
				"          PDP_CONTEXT_TIMEUTC as string,",
				"          CALL_DATE as date,",
				"          YYYYMM as integer,",
				"          CAUSE_FOR_TERM as short,",
				"          CHARGED_ITEM as string,",
				"          TOTAL_DURATION as short,",
				"          CEIL_DURATION as short,",
				"          DATA_VOL_IN as integer,",
				"          DATA_VOL_OUT as integer,",
				"          SIM_TOOLKIT_IND as string,",
				"          PARTIAL_TYPE_IND as string,",
				"          BASIC_SRVC_TYPE as string,",
				"          SRVC_CODE as string,",
				"          SRVC_TYPE as string,",
				"          CELL_ID as integer,",
				"          LOCATION_AREA as integer,",
				"          CALL_REFERENCE as string,",
				"          DEST_NETWORK as string,",
				"          ORIGINATING_NETWORK as string,",
				"          REC_ENTITY_ID as string,",
				"          REC_ENTITY_TYPE as short,",
				"          NETWORK_ACCESS_ID as string,",
				"          PDP_ADDRESS as string,",
				"          CHARGING_ID as long,",
				"          ACCESS_POINT_NAME_NI as string,",
				"          ACCESS_POINT_NAME_OI as string,",
				"          CML_ACCESS_POINT_NAME_NI as string,",
				"          CML_ACCESS_POINT_NAME_OI as string,",
				"          HOME_BID as string,",
				"          HOME_LOCATION_DESC as string,",
				"          SERVING_NETWORK as string,",
				"          SERVING_BID as string,",
				"          SERVING_LOCATION_DESC as string,",
				"          DIALLED_DIGITS as string,",
				"          CALLED_NUMBER as string,",
				"          CALLING_NO as string,",
				"          CALLED_PLACE as string,",
				"          CALLED_REGION as string,",
				"          CAMEL_DESTINATION_NUMBER as string,",
				"          THIRD_PARTY_NUMBER as string,",
				"          SMS_DEST_NO as string,",
				"          SMS_ORIGINATOR as string,",
				"          CTL_1 as short,",
				"          CTL_2 as short,",
				"          CTL_3 as short,",
				"          TYPE_OF_NUMBER as string,",
				"          CHARGEABLE_UNITS as integer,",
				"          CHARGED_UNITS as integer,",
				"          CHARGE as double,",
				"          TOTAL_TAX as boolean,",
				"          TOTAL_DISC as boolean,",
				"          CHRG_TYPE_00 as boolean,",
				"          CHRG_TYPE_01 as boolean,",
				"          CHRG_TYPE_03 as boolean,",
				"          CHRG_TYPE_04 as boolean,",
				"          CHRG_TYPE_21 as boolean,",
				"          CHRG_TYPE_50 as boolean,",
				"          TAX_TYPE_01 as boolean,",
				"          TAX_TYPE_02 as boolean,",
				"          TAX_TYPE_03 as boolean,",
				"          TAX_TYPE_04 as boolean,",
				"          CIF as string,",
				"          CIF_TAX as boolean,",
				"          SUPL_SRVC_CHARGE as boolean,",
				"          SUPL_SRVC_TAX as boolean,",
				"          SUPL_SRVC_CODE_1 as string,",
				"          SUPL_SRVC_CODE_2 as string,",
				"          SUPL_SRVC_CODE_3 as string,",
				"          CAMEL_SRVC_LEVEL as string,",
				"          CAMLE_SRVC_KEY as string,",
				"          CALLED_COUNTRY_CODE as string,",
				"          LOC_INT_CALL as string,",
				"          CAMEL_IND as boolean,",
				"          SUPL_SRVC_IND as boolean,",
				"          REC_ENTITY_TYPE_LIST_2 as short,",
				"          REC_ENTITY_ID_LIST_2 as string,",
				"          REC_ENTITY_TYPE_LIST_3 as string,",
				"          REC_ENTITY_ID_LIST_3 as string,",
				"          REC_ENTITY_TYPE_LIST_4 as string,",
				"          REC_ENTITY_ID_LIST_4 as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false) ~> source1",
				"MapDrifted1 aggregate() ~> aggregate1",
				"source1 derive(SRCE_PLMN_CODE = toString(byName('SRCE_PLMN_CODE')),",
				"          DEST_PLMN_CODE = toString(byName('DEST_PLMN_CODE')),",
				"          FILE_SEQ_NO = toString(byName('FILE_SEQ_NO')),",
				"          IMSI = toString(toLong(byName('IMSI'))),",
				"          TOTAL_DURATION = toString(toLong(byName('TOTAL_DURATION'))),",
				"          CEIL_DURATION = toString(toLong(byName('CEIL_DURATION'))),",
				"          CHARGE = toString(toDouble(byName('CHARGE'))),",
				"          CHARGEABLE_UNITS = toString(toLong(byName('CHARGEABLE_UNITS')))) ~> MapDrifted1"
			]
		}
	}
}